include:
  - template: Security/Container-Scanning.latest.gitlab-ci.yml
  - template: Jobs/Dependency-Scanning.latest.gitlab-ci.yml
  #- template: Jobs/License-Scanning.latest.gitlab-ci.yml
  - template: Jobs/Secret-Detection.latest.gitlab-ci.yml
  
.merge_request_rules:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event" && ($CI_MERGE_REQUEST_TARGET_BRANCH_NAME == "main" ||  $CI_MERGE_REQUEST_TARGET_BRANCH_NAME == "master")
      when: on_success

.branch_push_rules:
  rules:
    - if:  $CI_PIPELINE_SOURCE == "push" && ($CI_COMMIT_BRANCH == "main" || $CI_COMMIT_BRANCH == "master")
      when: on_success

.tag_creation_rules:
  rules:
    - if:  $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_TAG =~ '/^v.*/'
      when: on_success

.web_request_build_rules:
  rules:
    - if:  $CI_PIPELINE_SOURCE == "web" && $ENV != "nc_test" && $ENV != "nc_prod"
      when: on_success

.web_request_analysis_rules:
  rules:
    - if:  $CI_PIPELINE_SOURCE == "web" && $RUN_ANALYSIS == "true"
      when: on_success

.web_request_ec_dev_deploy_rules:
  rules:
    - if:  $CI_PIPELINE_SOURCE == "web" && $ENV == "ec_dev"
      when: on_success

.web_request_nc_dev_deploy_rules:
  rules:
    - if:  $CI_PIPELINE_SOURCE == "web" && $ENV == "nc_dev"
      when: on_success

.web_request_nc_test_deploy_rules:
  rules:
    - if:  $CI_PIPELINE_SOURCE == "web" && $ENV == "nc_test" && $CI_COMMIT_TAG =~ '/^v.*/'
      when: on_success

.web_request_nc_prod_deploy_rules:
  rules:
    - if:  $CI_PIPELINE_SOURCE == "web" && $ENV == "nc_prod" && $CI_COMMIT_TAG =~ '/^v.*/'
      when: on_success

default:
  services:
    - name: $DOCKER_REGISTRY_URL/$DOCKER_REGISTRY_REPOSITORY/common/docker:24.0.7-dind
      alias: docker
      command: ["--tls=false"]      
  tags:
    - ncso_builder

workflow:
  rules:
    - if: $CI_COMMIT_TAG != null
      variables:
        IMAGE_NAME: "$DOCKER_REGISTRY_URL/$DOCKER_REGISTRY_REPOSITORY/release/$CI_PROJECT_NAME:$CI_COMMIT_TAG"
        DOCKER_HOST: tcp://docker:2375
        DOCKER_TLS_CERTDIR: ""
    - if: $CI_COMMIT_TAG == null
      variables:
        IMAGE_NAME: "$DOCKER_REGISTRY_URL/$DOCKER_REGISTRY_REPOSITORY/$CI_PROJECT_NAME:$CI_COMMIT_SHORT_SHA"
        DOCKER_HOST: tcp://docker:2375
        DOCKER_TLS_CERTDIR: ""

stages:
  - linter
  #- unit-tests
  - sonarQube
  - build-and-push-image
  - test  
  - deploy


linter:
  stage: linter
  image: $DOCKER_REGISTRY_URL/$DOCKER_REGISTRY_REPOSITORY/common/python:3.11.6
  script:
    - pip install pylama
    - pip uninstall pyflakes -y
    - pylama .
  when: always
  rules:
    - !reference [.merge_request_rules, rules]
    - !reference [.branch_push_rules, rules]
    - !reference [.tag_creation_rules, rules]
    - !reference [.web_request_build_rules, rules]

