sonarQube:
  stage: sonarQube
  image:  $DOCKER_REGISTRY_URL/$DOCKER_REGISTRY_REPOSITORY/common/sonarscannernode-6.0.0.4432:jdk20
  script:
    - |
        if $SONAR_PROXY_REQUIRED == "true"; then
            echo "Setting proxy for Sonar"
            export SONAR_SCANNER_OPTS="-Dhttps.proxyHost=cloudproxy.nat.bt.com -Dhttps.proxyPort=8080"
        fi
    - >
      sonar-scanner
      -Dsonar.projectKey=$CI_PROJECT_NAME
      -Dsonar.projectName=$CI_PROJECT_NAME
      -Dsonar.sources=svc
      -Dsonar.exclusions=tests
      -Dsonar.tests=tests
      -Dsonar.projectVersion=v1.0
      -Dsonar.host.url=$SONAR_URL
      -Dsonar.login=$SONAR_LOGIN
      -Dsonar.links.ci=$CI_JOB_URL
      -Dsonar.qualitygate.wait=true
      -Dsonar.python.coverage.reportPaths=coverage.xml
      -Dsonar.python.xunit.reportPath=test-results.xml
  when: always
  allow_failure: true  
  rules:
    - !reference [.merge_request_rules, rules]
    - !reference [.branch_push_rules, rules]
    - !reference [.tag_creation_rules, rules]
    - !reference [.web_request_build_rules, rules]

build-and-push-image:
  stage: build-and-push-image
  image: $DOCKER_REGISTRY_URL/$DOCKER_REGISTRY_REPOSITORY/common/docker:20.10.10  
  before_script:
    - docker login -u $DOCKER_REGISTRY_USER -p $DOCKER_REGISTRY_PASSWORD $DOCKER_REGISTRY_URL
  script:
    - echo "Building image"
    - export DOCKER_BUILDKIT=0    
    - docker build --no-cache --build-arg PIP_TOKEN=$PIP_TOKEN --build-arg MINIO_HOST_URL --build-arg MINIO_ACCESS_KEY --build-arg MINIO_SECRET_KEY -t $IMAGE_NAME .
    - docker push $IMAGE_NAME
  allow_failure: false
  rules:
    - !reference [.merge_request_rules, rules]
    - !reference [.branch_push_rules, rules]
    - !reference [.tag_creation_rules, rules]
    - !reference [.web_request_build_rules, rules]

container_scanning:
  variables:
    CS_IMAGE: "$IMAGE_NAME"
    CS_REGISTRY_USER: "$DOCKER_REGISTRY_USER"
    CS_REGISTRY_PASSWORD: "$DOCKER_REGISTRY_PASSWORD"
    CS_DOCKER_INSECURE: "true"
  rules:
    - !reference [.merge_request_rules, rules]
    - !reference [.branch_push_rules, rules]
    - !reference [.tag_creation_rules, rules]
    - !reference [.web_request_analysis_rules, rules]

gemnasium-python-dependency_scanning:
  rules:
    - !reference [.merge_request_rules, rules]
    - !reference [.branch_push_rules, rules]
    - !reference [.tag_creation_rules, rules]
    - !reference [.web_request_analysis_rules, rules]

#license_scanning:
#  rules:
#    - !reference [.merge_request_rules, rules]
#    - !reference [.branch_push_rules, rules]
#    - !reference [.tag_creation_rules, rules]
#    - !reference [.web_request_analysis_rules, rules]

secret_detection:
  rules:
    - !reference [.merge_request_rules, rules]
    - !reference [.branch_push_rules, rules]
    - !reference [.tag_creation_rules, rules]
    - !reference [.web_request_analysis_rules, rules]

deploy_to_ec_dev:
  stage: deploy
  environment: 
    deployment_tier: development
    name: dev2
  image:
    name: $DOCKER_REGISTRY_URL/$DOCKER_REGISTRY_REPOSITORY/common/k8_envsubt:latest
    entrypoint: [""]
  script:
    - kubectl config set-cluster deploy-cluster --server="$K8_EC_DEV_SERVER" --insecure-skip-tls-verify
    - kubectl config set-credentials gitlab --token=$(echo $K8_EC_DEV_TOKEN | base64 -d)
    - kubectl config set-context deploy-cluster --cluster=deploy-cluster --namespace=$K8_EC_DEV_NAMESPACE --user=gitlab
    - kubectl config use-context deploy-cluster    
    - NAMESPACE=$K8_EC_DEV_NAMESPACE TAG=$CI_COMMIT_SHORT_SHA DOCKER_IMAGE_NAME=$IMAGE_NAME envsubst < kube-manifest.yml > deploy.yaml
    - kubectl apply -f deploy.yaml
  rules:
    - !reference [.merge_request_rules, rules]
    - !reference [.branch_push_rules, rules]
    - !reference [.web_request_ec_dev_deploy_rules, rules]

deploy_to_nc_dev:
  tags:
    - ncso_nc_dev_test_deployer_new  
  stage: deploy
  environment: 
    deployment_tier: testing
    name: dev1
  image:
    name: $DOCKER_REGISTRY_URL/$DOCKER_REGISTRY_REPOSITORY/common/k8_envsubt:latest
    entrypoint: [""]
  script:
    - kubectl config set-cluster deploy-cluster --server="$K8_NC_DEV_SERVER_NEW" --insecure-skip-tls-verify
    - kubectl config set-credentials gitlab --token=$(echo $K8_NC_DEV_TOKEN_NEW | base64 -d)
    - kubectl config set-context deploy-cluster --cluster=deploy-cluster --namespace=$K8_NC_DEV_NAMESPACE --user=gitlab
    - kubectl config use-context deploy-cluster
    - unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy    
    - NAMESPACE=$K8_NC_DEV_NAMESPACE TAG=$CI_COMMIT_SHORT_SHA DOCKER_IMAGE_NAME=$IMAGE_NAME envsubst < kube-manifest.yml > deploy.yaml
    - kubectl apply -f deploy.yaml
  rules:
    - !reference [.tag_creation_rules, rules]
    - !reference [.web_request_nc_dev_deploy_rules, rules]

